{
  "name": "cascade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "npm run test:contract && npm run test:api && npm run test:client",
    "test:contract": "hardhat test",
    "test:api": "node --test server/test/evidence/*.test.mts",
    "test:client": "npm --prefix client test",
    "build:client": "npm --prefix client run build",
    "typecheck": "hardhat build && tsc --noEmit",
    "dev:chain": "hardhat node --network hardhatMainnet",
    "deploy:local": "hardhat run scripts/deploy-local.ts --network localhost"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.10",
    "chai": "^6.3.0",
    "hardhat": "^3.21.0",
    "typescript": "~5.8.3"
  },
  "overrides": {
    "zod": "^4.6.7"
  }
}
